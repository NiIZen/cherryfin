{
  "name": "cherryfin",
  "productName": "Cherryfin",
  "version": "0.6.2",
  "private": true,
  "description": "Jellyfin-Client für Windows mit tvOS-artiger Oberfläche",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c gray,blue \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win",
    "build:webos": "tsc --noEmit && vite build --mode webos",
    "package:webos": "npm run build:webos && node scripts/package-webos.mjs"
  },
  "build": {
    "appId": "local.cherryfin.app",
    "productName": "Cherryfin",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release/${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Cherryfin-portable-${version}.exe"
    },
    "extraResources": [
      {
        "from": "vendor/mpv",
        "to": "mpv"
      }
    ],
    "asarUnpack": [
      "node_modules/@koromix/**"
    ]
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@jellyfin/sdk": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@webos-tools/cli": "^3.2.6",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "hls.js": "^1.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "author": "Cherryfin",
  "dependencies": {
    "koffi": "^3.3.7"
  },
  "license": "GPL-3.0-or-later"
}
